erDiagram



PROJECT_METADATA {
    string key PK
    string value
}

PROJECT_SETTINGS {
    string key PK
    string value
}

SUBSET {
    int id PK
    string name UK
    string details
    string display_color
}

TOOL {
    int id PK
    string name UK
    string type
    string parser
    json settings
    string display_color
}

SAMPLE {
    int id PK
    string name UK
    int subset_id FK
    json additions
    bool outlier
}

SPECTRE_FILE {
    int id PK
    int sample_id FK
    string format
    string path
}

SPECTRE {
    int id PK
    int spectre_file_id FK
    int seq_no
    string title
    int scans
    int charge
    float rt
    float pepmass
    float intensity
    blob mz_array
    blob intensity_array
    int peaks_count
    blob charge_array
    int charge_array_common_value
    json all_params
}

IDENTIFICATION_FILE {
    int id PK
    int spectre_file_id FK
    int tool_id FK
    string file_path
    string selection_field
    string selection_field_value
}

IDENTIFICATION {
    int id PK
    int spectre_id FK
    int tool_id FK
    int ident_file_id FK
    bool is_preferred
    string sequence
    string canonical_sequence
    float ppm
    float theor_mass
    float score
    json positional_scores
    float intensity_coverage
    int ions_matched
    string ion_match_type
    int top_peaks_covered
    int override_charge
    string source_sequence
    int isotope_offset
    float quality
    float override_pepmass
    bool has_ptm
    float lcrr
    int unconfirmed_ptms
    string src_file_protein_id
    float fdr
    float e_value
    float q_value
}

PROTEIN {
    string id PK
    bool is_uniprot
    string fasta_name
    string sequence
    string gene
    string name
    blob uniprot_data
    int taxon_id
    string organism_name
}

PEPTIDE_MATCH {
    int id PK
    string protein_id FK
    int identification_id FK
    string matched_sequence
    float identity
    float matched_ppm
    float matched_theor_mass
    bool unique_evidence
    float matched_coverage_percent
    int matched_peaks
    int matched_top_peaks
    string matched_ion_type
    string matched_sequence_modified
    bool substitution
}

PROTEIN_IDENTIFICATION_RESULT {
    int id PK
    string protein_id FK
    int sample_id FK
    int peptide_count
    int uq_evidence_count
    float coverage
    float intensity_sum
}

PROTEIN_QUANTIFICATION_RESULT {
    int id PK
    int protein_identification_id FK
    string algorithm
    float rel_value
    float abs_value_mol
    float abs_value_gl
}

SAMPLE_STATUS_CACHE {
    int sample_id PK_FK
    int spectra_files_count
    int ident_files_count
    int identifications_count
    int preferred_count
    int coverage_known_count
    int protein_ids_count
    int empty_ident_files_count
    datetime updated_at
}

GENERATED_REPORTS {
    int id PK
    string report_name
    string name
    datetime created_at
    blob plots
    blob tables
    json project_settings
    json tools_settings
    json report_settings
}

REPORT_PARAMETERS {
    int id PK
    string report_name UK
    json parameters
}

SAVED_PLOTS {
    int id PK
    datetime created_at
    string plot_type
    json settings
    blob plot
}

SUBSET ||--o{ SAMPLE : contains
SAMPLE ||--o{ SPECTRE_FILE : contains
SPECTRE_FILE ||--o{ SPECTRE : includes
SPECTRE ||--o{ IDENTIFICATION : describes
TOOL ||--o{ IDENTIFICATION_FILE : produces
IDENTIFICATION_FILE ||--o{ IDENTIFICATION : contains
TOOL ||--o{ IDENTIFICATION : produces
IDENTIFICATION ||--o{ PEPTIDE_MATCH : has
PROTEIN ||--o{ PEPTIDE_MATCH : matched_by
PROTEIN ||--o{ PROTEIN_IDENTIFICATION_RESULT : describes
SAMPLE ||--o{ PROTEIN_IDENTIFICATION_RESULT : describes
PROTEIN_IDENTIFICATION_RESULT ||--o{ PROTEIN_QUANTIFICATION_RESULT : quantified_by
SAMPLE ||--o{ SAMPLE_STATUS_CACHE : cached_stats
